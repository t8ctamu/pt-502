<h1>Members</h1>
<table>
  <thead>
    <tr>
      <th>ID</th><th>First name</th><th>Last name</th><th>Email</th>
      <th>Joined</th><th>Car pool</th><th>Points</th>
      <th>Plans to apply to PT school</th><th>Paid dues</th><th>Status</th>
      <th>Status</th>
      <% if current_member.manager? %>
        <th>Change Role</th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @members.each do |m| %>
      <tr>
        <td><%= m.id %></td>
        <td><%= m.first_name %></td>
        <td><%= m.last_name %></td>
        <td><%= m.email %></td>
        <td><%= m.joined_at %></td>
        <td><%= m.car_pool_status ? "Yes" : "No" %></td>
        <td>
          <%= form_with model: m, url: member_path(m), method: :patch do |f| %>
            <%= f.number_field :points, style: "width: 4em;", onchange: "this.form.requestSubmit()" %>
          <% end %>
        </td>
        <td><%= m.pt_school_application_date&.strftime("%b %Y") %></td>
        <td>
          <%= form_with model: m, url: member_path(m), method: :patch do |f| %>
            <%= f.check_box :paid_dues, onchange: "this.form.requestSubmit()" %>
          <% end %>
        </td>
        <td>
          <% if m.points >= 7 && m.paid_dues %>
            <span class="status-badge status-active">Active</span>
          <% else %>
            <span class="status-badge status-inactive">Not Active</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if current_member.manager? %>
  <h2>Admins</h2>

  <% if @admins_error %>
    <p class="flash flash__alert"><%= @admins_error %></p>
  <% elsif @admins.blank? %>
    <p>No admins to display.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>ID</th><th>Role</th><th>First name</th><th>Last name</th><th>Email</th>
          <th>Joined</th><th>Car pool</th>
          <th>Plans to apply to PT school</th><th>Phone</th>
        </tr>
      </thead>
      <tbody>
        <% @admins.each do |a| %>
          <tr>
            <td><%= a.id %></td>
            <td><%= a.role.description %></td>
            <td><%= a.first_name %></td>
            <td><%= a.last_name %></td>
            <td><%= a.email %></td>
            <td><%= a.joined_at %></td>
            <td><%= a.car_pool_status ? "Yes" : "No" %></td>
            <td><%= a.pt_school_application_date&.strftime("%b %Y") %></td>
            <td><%= a.phone_visible? ? a.phone_number.presence || "—" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>