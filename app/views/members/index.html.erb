<div class="btn-group" style="margin-bottom: 16px;">
  <%= button_to "Reset Semester",
        reset_semesters_path,
        method: :post,
        form: { data: { turbo_confirm: "This will start a new semester. Members' current points will no longer count toward the new semester's totals. Their history is preserved. Continue?" } } %>
</div>

<%# Builds a sortable <th>: the label links to this page sorted by `key`.
    Clicking the active column toggles asc/desc; existing filters are preserved. %>
<% sortable = lambda do |label, key|
     current    = params[:sort] == key
     descending = current && params[:dir] == "desc"
     next_dir   = current && !descending ? "desc" : "asc"
     arrow      = current ? (descending ? " ▼" : " ▲") : ""
     aria_sort  = current ? (descending ? "descending" : "ascending") : "none"

     tag.th(
       link_to("#{label}#{arrow}",
               members_path(request.query_parameters.merge(sort: key, dir: next_dir))),
       aria: { sort: aria_sort }
     )
   end %>

<h1>Members</h1>

<%= form_with url: members_path, method: :get, class: "filters", style: "margin-bottom: 16px;" do |f| %>
  <%= f.label :car_pool, "Car pool" %>
  <%= f.select :car_pool, [["Any", ""], ["Yes", "yes"], ["No", "no"]], selected: params[:car_pool] %>

  <%= f.label :status, "Status" %>
  <%= f.select :status, [["Any", ""], ["Active", "active"], ["Not Active", "inactive"]], selected: params[:status] %>

  <%= f.label :points_requirement_id, "Points for" %>
  <%= f.select :points_requirement_id,
        options_from_collection_for_select(@requirements, :id, :name, params[:points_requirement_id]),
        include_blank: "Choose requirement" %>
  <%= f.select :points_filter,
        [["Any amount", ""], ["0 points", "zero"], ["1+ points", "positive"]],
        selected: params[:points_filter],
        aria: { label: "Points filter" } %>

  <%= f.hidden_field :sort, value: params[:sort], id: nil %>
  <%= f.hidden_field :dir,  value: params[:dir],  id: nil %>
  <%= f.submit "Apply filters" %>
  <%= link_to "Clear", members_path %>
<% end %>

<p><%= pluralize(@members.size, "member") %> shown</p>

<table class="point-sheet">
  <thead>
    <tr>
      <%= sortable.call("ID", "id") %>
      <%= sortable.call("Role", "role") %>
      <%= sortable.call("First name", "first_name") %>
      <%= sortable.call("Last name", "last_name") %>
      <%= sortable.call("Email", "email") %>
      <%= sortable.call("Joined", "joined_at") %>
      <th>Car pool</th>
      <% @requirements.each do |r| %>
        <%= sortable.call(r.name, "req_#{r.id}") %>
      <% end %>
      <%= sortable.call("Total", "total") %>
      <%= sortable.call("Expected graduation", "expected_graduation") %>
      <%= sortable.call("Anticipated application cycle", "anticipated_cycle") %>
      <th>Shared phone number</th>
      <%= sortable.call("Paid dues", "paid_dues") %>
      <th>Status</th><th>Profile</th>
      <% if current_member.manager? %>
        <th>Change Role</th>
      <% end %>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @members.each do |m| %>
      <tr>
        <td><%= m.id %></td>
        <td><%= m.role.description %></td>
        <td><%= m.first_name.presence || "N/A" %></td>
        <td><%= m.last_name.presence || "N/A" %></td>
        <td><%= m.email.presence || "N/A" %></td>
        <td><%= m.joined_at %></td>
        <td><%= m.car_pool_status ? "Yes" : "No" %></td>
        <% @requirements.each do |r| %>
          <td>
            <%= form_with url: set_points_member_path(m), method: :patch do |f| %>
              <%= f.hidden_field :requirement_id, value: r.id, id: nil %>
              <%= f.number_field :total, value: m.points_by_requirement[r.id].to_i,
                    min: 0, step: 1, id: nil, style: "width: 4em;",
                    onchange: "this.form.requestSubmit()" %>
            <% end %>
          </td>
        <% end %>
        <td><%= m.total_points %></td>
        <td><%= m.expected_graduation_term.presence || "Not provided" %></td>
        <td><%= m.anticipated_application_cycle || "Not provided" %></td>
        <td><%= m.shared_phone_number || "Not shared" %></td>
        <td>
          <%= form_with model: m, url: member_path(m), method: :patch do |f| %>
            <%= f.check_box :paid_dues, onchange: "this.form.requestSubmit()" %>
          <% end %>
        </td>
        <td>
          <% if m.active_status? && m.paid_dues %>
            <span class="status-badge status-active">Active</span>
          <% else %>
            <span class="status-badge status-inactive">Not Active</span>
            <% unless m.active_status? %>
              <small class="status-missing"><%= m.missing_requirements_text.capitalize %></small>
            <% end %>
          <% end %>
        </td>
        <td><%= link_to "Edit profile", edit_member_path(m), aria: { label: "Edit profile for #{m.first_name} #{m.last_name}" } %></td>
        <% if current_member.manager? %>
          <td>
            <% if m == current_member || m.manager? %>
              <%= m.role.description %>
            <% elsif m.admin? %>
              <%= button_to "Demote to Member", change_role_member_path(m),
                    method: :patch, params: { role: "Member" },
                    form: { data: { turbo_confirm: "Demote this admin to Member?" } } %>
            <% else %>
              <%= button_to "Promote to Admin", change_role_member_path(m),
                    method: :patch, params: { role: "Admin" },
                    form: { data: { turbo_confirm: "Promote this member to Admin?" } } %>
            <% end %>
          </td>
        <% end %>
         <td>
           <% if m == current_member || m.manager? %>
             <span class="muted">-</span>
           <% else %>
             <%= button_to "Remove", remove_member_path(m),
                   method: :patch,
                   form: { data: { turbo_confirm: "Remove #{m.first_name} from the roster?" } } %>
           <% end %>
         </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @removed_members.any? %>
  <details>
    <summary>Removed members (<%= @removed_members.count %>)</summary>
    <table>
      <thead>
        <tr>
          <th>Name</th><th>Email</th><th>Removed on</th><th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @removed_members.each do |m| %>
          <tr>
            <td><%= m.first_name %> <%= m.last_name %></td>
            <td><%= m.email %></td>
            <td><%= m.removed_at&.strftime("%b %-d, %Y") %></td>
            <td>
              <%= button_to "Restore", restore_member_path(m),
                    method: :patch,
                    form: { data: { turbo_confirm: "Restore #{m.first_name} to the roster?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>

<% if current_member.admin? %>
  <h2>Admins</h2>

  <% if @admins_error %>
    <p class="flash flash__alert"><%= @admins_error %></p>
  <% elsif @admins.blank? %>
    <p>No admins to display.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>ID</th><th>Role</th><th>First name</th><th>Last name</th><th>Email</th>
          <th>Joined</th><th>Car pool</th>
          <th>Expected graduation</th><th>Anticipated application cycle</th><th>Shared phone number</th><th>Profile</th>
          <% if current_member.manager? %>
            <th>Change Role</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @admins.each do |a| %>
          <tr>
            <td><%= a.id %></td>
            <td><%= a.role.description %></td>
            <td><%= a.first_name.presence || "N/A" %></td>
            <td><%= a.last_name.presence || "N/A" %></td>
            <td><%= a.email.presence || "N/A" %></td>
            <td><%= a.joined_at %></td>
            <td><%= a.car_pool_status ? "Yes" : "No" %></td>
            <td><%= a.expected_graduation_term.presence || "Not provided" %></td>
            <td><%= a.anticipated_application_cycle || "Not provided" %></td>
            <td><%= a.shared_phone_number || "Not shared" %></td>
            <td><%= link_to "Edit profile", edit_member_path(a), aria: { label: "Edit profile for #{a.first_name} #{a.last_name}" } %></td>
            <% if current_member.manager? %>
              <td>
                <% if a == current_member || a.manager? %>
                  <%= a.role.description %>
                <% else %>
                  <%= button_to "Demote to Member", change_role_member_path(a),
                        method: :patch, params: { role: "Member" },
                        form: { data: { turbo_confirm: "Demote this admin to Member?" } } %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>
