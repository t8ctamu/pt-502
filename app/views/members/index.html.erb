<h1>Members</h1>

<table>
  <thead>
    <tr>
      <th>ID</th><th>Role</th><th>First name</th><th>Last name</th><th>Email</th>
      <th>Joined</th><th>Car pool</th><th>Points</th><th>Plans to apply to PT school</th>
    </tr>
  </thead>
  <tbody>
    <% @members.each do |m| %>
      <tr>
        <td><%= m.id %></td>
        <td>
          <%= form_with model: m, url: member_path(m), method: :patch do |f| %>
            <%= f.select :role_id, Role.pluck(:description, :id), selected: m.role_id %>
            <%= f.submit "Save" %>
          <% end %>
        </td>
        <td><%= m.first_name %></td>
        <td><%= m.last_name %></td>
        <td><%= m.email %></td>
        <td><%= m.joined_at %></td>
        <td><%= m.car_pool_status ? "Yes" : "No" %></td>
        <td><%= m.points %></td>
        <td><%= m.pt_school_application_date&.strftime("%b %Y") %></td>
      </tr>
    <% end %>
  </tbody>
</table>