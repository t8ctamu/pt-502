<%= form_with model: member, url: url, method: :patch, data: { controller: "profile" } do |f| %>
  <% if member.errors.any? %>
    <div class="form-errors" role="alert" tabindex="-1" aria-labelledby="profile-errors-title" data-profile-target="errors">
      <h2 id="profile-errors-title">Please correct your profile</h2>
      <ul>
        <% member.errors.each do |error| %>
          <li>
            <% if error.attribute == :base %>
              <%= error.full_message %>
            <% else %>
              <%= link_to error.full_message, "#member_#{error.attribute}" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>First name, last name, expected graduation, and anticipated application cycle are required.</p>
  <div>
    <%= f.label :first_name %>
    <%= f.text_field :first_name, **profile_field_options(member, :first_name), required: true, autocomplete: "given-name" %>
    <%= render "profiles/field_error", member: member, field: :first_name %>
  </div>
  <div>
    <%= f.label :last_name %>
    <%= f.text_field :last_name, **profile_field_options(member, :last_name), required: true, autocomplete: "family-name" %>
    <%= render "profiles/field_error", member: member, field: :last_name %>
  </div>
  <div>
    <%= f.label :expected_graduation_term, "Expected graduation" %>
    <%= f.select :expected_graduation_term, graduation_term_options(member), { prompt: "Choose a graduation term" },
                 profile_field_options(member, :expected_graduation_term).merge(required: true) %>
    <%= render "profiles/field_error", member: member, field: :expected_graduation_term %>
  </div>
  <div>
    <%= f.label :pt_school_application_date, "Anticipated application cycle" %>
    <%= f.select :pt_school_application_date, application_cycle_options(member),
                 { prompt: "Choose a summer term", selected: member.pt_school_application_date && Date.new(member.pt_school_application_date.year, 6, 1).iso8601 },
                 profile_field_options(member, :pt_school_application_date, hint: "application-cycle-hint").merge(required: true) %>
    <p id="application-cycle-hint">Select the summer you plan to apply to PT school.</p>
    <%= render "profiles/field_error", member: member, field: :pt_school_application_date %>
  </div>
  <div>
    <%= f.check_box :car_pool_status %>
    <%= f.label :car_pool_status, "I am available to carpool for field trips" %>
  </div>
  <% if local_assigns.fetch(:phone_controls, true) %>
    <div>
      <%= f.check_box :share_phone_number, data: { profile_target: "consent", action: "profile#togglePhone" }, aria: { describedby: "phone-sharing-hint" } %>
      <%= f.label :share_phone_number, "Share my phone number with officers (optional)" %>
      <p id="phone-sharing-hint">Your phone number is shared only when you opt in. Turning this off removes your saved number.</p>
    </div>
    <div data-profile-target="phoneFields">
      <%= f.label :phone_number, "Phone number" %>
      <%= f.telephone_field :phone_number, **profile_field_options(member, :phone_number, hint: "phone-number-hint"),
                            autocomplete: "tel", maxlength: 40, data: { profile_target: "phoneInput" } %>
      <p id="phone-number-hint">Required only if you share it. Include 10 to 15 digits, for example (979) 555-0123.</p>
      <%= render "profiles/field_error", member: member, field: :phone_number %>
    </div>
  <% end %>

  <%= f.submit "Save profile", class: "btn" %>
<% end %>
