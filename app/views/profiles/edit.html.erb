<div class="form-page">
  <div class="card">
    <h1>Edit your profile</h1>

    <%= form_with model: @member, url: profile_path, method: :patch do |f| %>
      <% if @member.errors.any? %>
        <div class="form-errors">
          <h2><%= pluralize(@member.errors.count, "error") %> prohibited this profile from being saved:</h2>
          <ul>
            <% @member.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :first_name %>
        <%= f.text_field :first_name, required: true %>
      </div>
      <div>
        <%= f.label :last_name %>
        <%= f.text_field :last_name, required: true %>
      </div>
      <div>
        <%= f.label :pt_school_application_date, "When do you plan to apply to PT school?" %>
        <%= f.date_field :pt_school_application_date, required: true %>
      </div>
      <div class="checkbox-field">
        <%= f.check_box :car_pool_status %>
        <%= f.label :car_pool_status, "I can carpool" %>
      </div>

      <%= f.submit "Save", class: "btn" %>
    <% end %>
  </div>
</div>