<h1>Event approval queue</h1>

<% if @submissions.empty? %>
  <p>No pending requests.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Member</th><th>Event</th><th>Date</th><th>Point type</th>
        <th>Description / proof</th><th>Approve</th><th>Deny</th>
      </tr>
    </thead>
    <tbody>
      <% @submissions.each do |s| %>
        <tr>
          <td><%= s.member.first_name %> <%= s.member.last_name %><br><small><%= s.member.email %></small></td>
          <td><%= s.name %></td>
          <td><%= s.event_date.strftime("%b %-d, %Y") %></td>
          <td><%= s.requirement.name %></td>
          <td><%= simple_format(s.description) %></td>
          <td>
            <%= form_with url: approve_submission_review_path(s), method: :patch do %>
              <%= number_field_tag :points, 1, min: 1, step: 1, id: nil, style: "width: 4em;" %>
              <%= submit_tag "Approve" %>
            <% end %>
          </td>
          <td>
            <%= form_with url: deny_submission_review_path(s), method: :patch do %>
              <%= text_field_tag :reason, nil, placeholder: "Reason (required)", id: nil, required: true %>
              <%= submit_tag "Deny" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>