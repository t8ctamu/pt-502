<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pt502" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if member_signed_in? %>
      <nav>
        <div class="nav-left">
          <div class="nav-user">
            <span class="nav-name">Welcome, <%= current_member.first_name %> <span class="nav-caret">▾</span></span>
            <span class="role-badge"><%= display_role(current_member) %></span>
            <div class="nav-dropdown">
              <div class="nav-dropdown-inner">
                <%= link_to "Edit my profile", edit_profile_path %>
              </div>
            </div>
          </div>

          <%= link_to "Home", root_path %>
          <% if current_member.admin? %>
            <%= link_to "Members", members_path %>
          <% end %>
          <%= link_to "Events", events_path %>
          <% if current_member&.manager? %>
            <%= link_to "Point requirements", point_settings_path %>
          <% end %>
        </div>

        <div class="nav-right">
          <%= link_to "Sign out", destroy_member_session_path, class: "nav-signout" %>
        </div>
      </nav>
    <% end %>

    <% flash.each do |key, value| %>
      <section class="flash flash__<%= key %>"><%= value %></section>
    <% end %>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>