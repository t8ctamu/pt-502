<% content_for :title, "Help | PT Society" %>
<% content_for :body_class, "help-layout" %>
<main class="help-page">
  <%= render "navigation" %>
  <header>
    <p class="help-eyebrow">PT Society member portal</p>
    <h1>Help and training</h1>
    <p>Find the steps for your next task, or use a guide to walk someone through their first visit.</p>
  </header>
  <div class="help-categories">
    <section class="card">
      <h2>For members</h2>
      <p>Sign in, edit your profile, check your points, attend events, and submit an outside event.</p>
      <%= link_to "Open member guide", member_help_path, class: "btn" %>
    </section>
    <% if current_member&.admin? %>
      <section class="card">
        <h2>For officers</h2>
        <p>Manage member information, dues, points, events, attendance, and approval requests.</p>
        <%= link_to "Open officer guide", officer_help_path, class: "btn" %>
      </section>
      <section class="card">
        <h2>For system owners</h2>
        <p>Set up and maintain the service. This separate guide covers hosting, backups, recovery, and costs.</p>
        <%= link_to "Open system guide", system_help_path, class: "btn" %>
      </section>
    <% else %>
      <section class="card">
        <h2>Need help now?</h2>
        <p>Start with the member guide’s troubleshooting section. Officers can find additional guides here after signing in.</p>
        <%= link_to "Find a fix", member_help_path(anchor: "troubleshooting"), class: "btn" %>
      </section>
    <% end %>
  </div>
  <p class="help-review">Login navigation checked October 27, 2026. Other guide content and screenshots checked October 10, 2026.</p>
</main>
