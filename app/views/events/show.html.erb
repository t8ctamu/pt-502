<h1><%= @event.name %></h1>
<p><%= @event.description %></p>
<p><strong>Time:</strong> <%= @event.starts_at.strftime("%b %d, %Y %I:%M %p") %></p>
<p><strong>Location:</strong> <%= @event.location %></p>

<p>
  <%= link_to "Download .ics", ics_event_path(@event, format: :ics) %> |
  <%= link_to "Add to Google Calendar",
      "https://calendar.google.com/calendar/render?" + {
        action: "TEMPLATE",
        text: @event.name,
        dates: "#{@event.starts_at.utc.strftime("%Y%m%dT%H%M%SZ")}/#{(@event.ends_at || @event.starts_at + 1.hour).utc.strftime("%Y%m%dT%H%M%SZ")}",
        details: @event.description,
        location: @event.location
      }.to_query, target: "_blank" %>
</p>

<% if current_member.admin? %>
  <section aria-labelledby="attendance-heading">
    <h2 id="attendance-heading">Attendance</h2>
    <% if @attendance_load_failed %>
      <p role="alert">Attendance couldn't be loaded. Please try again.</p>
      <p><%= link_to "Try again", event_path(@event) %></p>
    <% elsif @attendances.empty? %>
      <p>No attendees yet.</p>
    <% else %>
      <table>
        <caption>Members present at <%= @event.name %></caption>
        <thead>
          <tr><th scope="col">Name</th><th scope="col">Check-in time</th></tr>
        </thead>
        <tbody>
          <% @attendances.each do |attendance| %>
            <tr>
              <td><%= [attendance.member.first_name, attendance.member.last_name].compact.join(" ") %></td>
              <td><time datetime="<%= attendance.checked_in_at.iso8601 %>"><%= attendance.checked_in_at.strftime("%b %d, %Y %I:%M %p %Z") %></time></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    <p><%= link_to "Refresh attendance", event_path(@event) %></p>
  </section>
<% end %>

<%= link_to "Back to events", events_path %>
