<div class="card event-detail">
  <div class="event-detail-header">
    <div class="event-date-badge event-date-badge-lg">
      <span class="event-month"><%= @event.starts_at.strftime("%b") %></span>
      <span class="event-day"><%= @event.starts_at.strftime("%d") %></span>
    </div>

    <div>
      <h1><%= @event.name %></h1>

      <p class="event-meta-large">
        🕒 <%= @event.starts_at.strftime("%I:%M %p") %>
        <% if @event.ends_at.present? %>
          – <%= @event.ends_at.strftime("%I:%M %p") %>
        <% end %>
      </p>

      <p class="event-meta-large">
        📍 <%= @event.location %>
      </p>

      <% if @event.requirement %>
        <p class="event-meta-large">⭐ <%= pluralize(@event.point_value, "point") %> · <%= @event.requirement.name %></p>
      <% end %>
    </div>
  </div>

  <% if @event.description.present? %>
    <p class="event-description"><%= @event.description %></p>
  <% end %>

  <% if current_member.admin? %>
    <section aria-labelledby="attendance-heading">
      <h2 id="attendance-heading">Attendance</h2>

      <% if @event.check_in_configured? %>
        <p>
          <%= link_to "Show check-in QR code", check_in_qr_event_path(@event) %>
        </p>
      <% else %>
        <p>
          <%= link_to "Configure attendance check-in", edit_event_path(@event) %>
        </p>
      <% end %>

      <% if @attendance_load_failed %>
        <p role="alert">
          Attendance couldn't be loaded. Please try again.
        </p>

        <p>
          <%= link_to "Try again", event_path(@event) %>
        </p>

      <% elsif @attendances.empty? %>
        <p>No attendees yet.</p>

      <% else %>
        <table>
          <caption>Members present at <%= @event.name %></caption>

          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Check-in time</th>
            </tr>
          </thead>

          <tbody>
            <% @attendances.each do |attendance| %>
              <tr>
                <td>
                  <%= [
                    attendance.member.first_name,
                    attendance.member.last_name
                  ].compact.join(" ") %>
                </td>

                <td>
                  <time datetime="<%= attendance.checked_in_at.iso8601 %>">
                    <%= attendance.checked_in_at.strftime("%b %d, %Y %I:%M %p %Z") %>
                  </time>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <p>
        <%= link_to "Refresh attendance", event_path(@event) %>
      </p>
    </section>
  <% end %>

  <% check_in_opens_at = @event.starts_at - 10.minutes %>
<% check_in_closes_at = @event.ends_at || @event.starts_at + 1.hour %>


  <div class="event-primary-action">

    <% if @attendance&.checked_in_at? %>
      <div class="attendance-confirmed">
        ✓ You're checked in!
      </div>
    <% elsif Time.current >= @event.starts_at - 10.minutes &&
            Time.current <= (@event.ends_at || @event.starts_at + 1.hour) %>
      <%= link_to "Attend Meeting",
          event_check_in_path(@event),
          class: "btn btn-rsvp" %>
    <% else %>
      <p class="event-meta-large">
        <% if Time.current < @event.starts_at - 10.minutes %>
          Check-in opens 10 minutes before the meeting starts.
        <% else %>
          Check-in is closed for this meeting.
        <% end %>
      </p>
    <% end %>
  </div>

  <div class="event-actions">
    <%= link_to "Download .ics",
        ics_event_path(@event, format: :ics),
        class: "btn btn-secondary" %>

    <%= link_to "Add to Google Calendar",
        "https://calendar.google.com/calendar/render?" + {
          action: "TEMPLATE",
          text: @event.name,
          dates: "#{@event.starts_at.utc.strftime("%Y%m%dT%H%M%SZ")}/#{(@event.ends_at || @event.starts_at + 1.hour).utc.strftime("%Y%m%dT%H%M%SZ")}",
          details: @event.description,
          location: @event.location
        }.to_query,
        target: "_blank",
        rel: "noopener",
        class: "btn btn-secondary" %>

    <% if current_member.admin? %>
      <%= link_to "Edit",
          edit_event_path(@event),
          class: "btn btn-secondary" %>
    <% end %>
  </div>

  <% if current_member.admin? %>
    <div class="event-delete">
      <%= button_to "Delete",
          event_path(@event),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Are you sure you want to delete this event?" } %>
    </div>
  <% end %>

  <div class="event-navigation">
    <%= link_to "← Back to events",
        events_path,
        class: "back-link" %>
  </div>
</div>
