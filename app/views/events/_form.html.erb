<%= form_with model: event, class: "event-form" do |f| %>
  <% if event.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(event.errors.count, "error") %> stopped this event from being saved:</h2>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <div class="form-row">
    <div>
      <%= f.label :starts_at, "Date and time" %>
      <%= f.datetime_local_field :starts_at %>
    </div>
    <div>
      <%= f.label :ends_at, "End time (optional)" %>
      <%= f.datetime_local_field :ends_at %>
    </div>
  </div>

  <div>
    <%= f.label :location %>
    <%= f.text_field :location %>
  </div>

  <fieldset data-controller="event-location">
    <legend>Attendance check-in</legend>
    <p>Set the meeting coordinates to enable QR check-in. Leave both blank to configure later.</p>
    <p>
      <%= f.label :latitude %><br>
      <%= f.number_field :latitude, step: "any", min: -90, max: 90, data: { event_location_target: "latitude" } %>
    </p>
    <p>
      <%= f.label :longitude %><br>
      <%= f.number_field :longitude, step: "any", min: -180, max: 180, data: { event_location_target: "longitude" } %>
    </p>
    <button type="button" data-action="event-location#locate" data-event-location-target="button">Use my current location</button>
    <p data-event-location-target="status" role="status"></p>
    <p>Use your current location only when you are at the meeting venue.</p>
    <p>
      <%= f.label :check_in_radius_meters, "Allowed distance (meters)" %><br>
      <%= f.number_field :check_in_radius_meters, min: 1, step: 1, required: true %>
    </p>
    <p>
      <%= f.label :point_value, "Points for attending" %><br>
      <%= f.number_field :point_value, min: 0, step: 1, required: true %>
      <%= f.label :requirement_id, "Point type" %>
        <%= f.collection_select :requirement_id, Requirement.active.order(:id), :id, :name,
              { include_blank: "No points" },
              { id: "event_requirement_id", data: { other_id: Requirement.find_by(name: "Other")&.id } } %>

        <div id="other-type-field" style="display: none;">
          <%= f.label :other_type, "What kind of event?" %>
          <%= f.text_field :other_type, placeholder: "e.g. Social, Fundraising" %>
        </div>

        <script>
          (function () {
            var select = document.getElementById("event_requirement_id");
            var field = document.getElementById("other-type-field");
            function toggle() {
              field.style.display = select.value === select.dataset.otherId ? "" : "none";
            }
            select.addEventListener("change", toggle);
            toggle();
          })();
        </script>
    </p>
  </fieldset>
  <%= f.submit "Save Event" %>
<% end %>
