<h1>Preview Import</h1>

<%= form_with url: preview_import_path(params[:token]), method: :get do |f| %>
  <h2>Column mapping</h2>
  <table>
    <thead><tr><th>#</th><th>Header</th><th>Maps to</th></tr></thead>
    <tbody>
      <% @headers.each_with_index do |header, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= header.presence || "(blank)" %></td>
          <td>
            <%= select_tag "mapping[#{i}]",
                  options_for_select(
                    [["Ignore", "ignore"],
                     ["Email", "email"],
                     ["First name", "first_name"],
                     ["Last name", "last_name"],
                     ["Full name", "full_name"],
                     ["Paid dues", "paid_dues"]] +
                    @requirements.map { |r| ["Requirement: #{r.name}", "requirement:#{r.id}"] },
                    @mapping[i.to_s]
                  ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= f.submit "Refresh preview" %>
<% end %>

<h2>Preview (<%= @preview_rows.size %> rows)</h2>
<table>
  <thead>
    <tr><th>Row</th><th>Status</th><th>Member</th><th>Points</th><th>Issues</th></tr>
  </thead>
  <tbody>
    <% @preview_rows.each do |row| %>
      <tr class="row--<%= row.status %>">
        <td><%= row.index %></td>
        <td><%= row.status %></td>
        <td>
          <strong><%= "#{row.attributes[:first_name]} #{row.attributes[:last_name]}".strip %></strong>
          <% if row.attributes[:email].present? %> · <%= row.attributes[:email] %><% end %>
          <br><small>Dues: <%= row.attributes[:paid_dues] ? "yes" : "no" %></small>
        </td>
        <td>
          <% row.points.group_by { |p| p[:requirement_id] }.each do |req_id, pts| %>
            <% req = @requirements.find { |r| r.id == req_id } %>
            <%= "#{req&.name || "?"} #{pts.sum { |p| p[:point_amount] }}" %>
          <% end %>
        </td>
        <td><%= row.errors.join(", ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= form_with url: confirm_import_path(params[:token]), method: :post do |f| %>
  <% @mapping.each do |col, field| %>
    <%= hidden_field_tag "mapping[#{col}]", field %>
  <% end %>
  <%= f.submit "Confirm import" %>
<% end %>

<%= link_to "Cancel", new_import_path %>