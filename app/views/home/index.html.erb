<div class="card">
  <h1>Welcome, <%= current_member.first_name %></h1>
  <p><span class="role-badge"><%= current_member.role.description %></span></p>
  <p><%= link_to "Edit my profile", edit_profile_path, class: "btn" %></p>
</div>

<% if current_member.admin? %>
  <div class="card">
    <h2>Officer tools</h2>
    <p><%= link_to "Member dashboard", members_path, class: "btn" %></p>
  </div>
<% end %>